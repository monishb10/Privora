# Android Release Keystore Configuration Template for Privora
#
# INSTRUCTIONS:
# 1. Generate a production release keystore if you don't have one:
#    keytool -genkey -v -keystore privora-release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias privora
#
# 2. Copy this file to `android/key.properties` (this file is git-ignored by default):
#    cp key.properties.example key.properties
#
# 3. Fill in your actual keystore path and passwords below:
#
# storePassword=your_keystore_password
# keyPassword=your_key_password
# keyAlias=privora
# storeFile=../privora-release-key.jks
#
# 4. In Google Cloud Console -> Credentials -> Android Client:
#    Verify that the SHA-1 signing fingerprint matches the output of:
#    keytool -list -v -keystore privora-release-key.jks -alias privora
