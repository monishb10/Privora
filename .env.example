# Privora Environment Configuration Template
# Pass these values at build/run time using --dart-define flags:
#
# Public Flutter build settings only. Never add Edge Function secrets here.
# The checked-in Privora configuration already has project defaults, so the
# normal command is simply: flutter run -d <DEVICE_ID>

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
ENABLE_GOOGLE_LOGIN=true
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
